@page "/tenants/{slug}/login/terms"
@model LoginTermsModel
@{ ViewData["Title"] = "Terms of service"; }

@if (Model.SignedIn)
{
    <h1>You are signed in</h1>
    <p>You can close this window and return to the application.</p>
    <p class="links"><a href="@Model.AccountUrl">Manage your account</a></p>
}
else
{
    <h1>Terms of service</h1>
    @if (Model.ErrorMessage is { } error)
    {
        <p class="error" role="alert">@error</p>
    }
    @if (Model.TermsUrl is { } termsUrl)
    {
        <p>Before you continue, please read and accept the
            <a href="@termsUrl" target="_blank" rel="noopener noreferrer">terms of service</a>.</p>
    }
    else
    {
        <p>Before you continue, please accept the terms of service.</p>
    }
    <form method="post">
        <p class="check">
            <input id="Accept" name="Accept" type="checkbox" value="true" required />
            <label for="Accept">I accept the terms of service</label>
        </p>
        <button type="submit">Continue</button>
    </form>
    <p class="links"><a href="@Model.StartOverUrl">Start over</a></p>
    @if (Model.ReturnToApplication is { } back)
    {
        <partial name="_ReturnToApplication" model="back" />
    }
}
