@page "/tenants/{slug}/login/code"
@model LoginCodeModel
@{ ViewData["Title"] = "Enter your code"; }

@if (Model.SignedIn)
{
    <h1>You are signed in</h1>
    <p>You can close this window and return to the application.</p>
    <p class="links"><a href="@Model.AccountUrl">Manage your account</a></p>
}
else
{
    <h1>Two-step verification</h1>
    @if (Model.ErrorMessage is { } error)
    {
        <p class="error" role="alert">@error</p>
    }
    <form method="post">
        <input type="hidden" name="UseRecoveryCode" value="@(Model.UseRecoveryCode ? "true" : "false")" />
        @if (Model.UseRecoveryCode)
        {
            <p>Enter one of the recovery codes you saved when you set up your authenticator app. Each code works once.</p>
            <label for="Code">Recovery code</label>
            <input id="Code" name="Code" autocomplete="off" autocapitalize="none" spellcheck="false" required autofocus />
        }
        else
        {
            <p>Enter the 6-digit code from your authenticator app.</p>
            <label for="Code">Code</label>
            <input id="Code" name="Code" inputmode="numeric" pattern="[0-9 ]*" autocomplete="one-time-code" maxlength="8" required autofocus />
        }
        <button type="submit">Verify</button>
    </form>
    <p class="links">
        @if (Model.UseRecoveryCode)
        {
            <a href="/tenants/@Model.Slug/login/code">Use a code from your authenticator app</a>
        }
        else
        {
            <a href="/tenants/@Model.Slug/login/code?UseRecoveryCode=true">Use a recovery code</a>
        }
        <br />
        <a href="@Model.StartOverUrl">Start over</a>
    </p>
    @if (Model.ReturnToApplication is { } back)
    {
        <partial name="_ReturnToApplication" model="back" />
    }
}
