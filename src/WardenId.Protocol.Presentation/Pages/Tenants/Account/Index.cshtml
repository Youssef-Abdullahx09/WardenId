@page "/tenants/{slug}/account"
@model IndexModel
@{ ViewData["Title"] = "Your account"; }

<h1>Your account</h1>
<dl>
    <dt>Email</dt>
    <dd>@Model.Account.Email</dd>
    <dt>Username</dt>
    <dd>@Model.Account.Username</dd>
</dl>

<h2>Password</h2>
<p><a href="@Model.AccountUrl/password">Change your password</a></p>

<h2>Two-step verification</h2>
@if (Model.Account.HasMfa)
{
    <p>On.</p>
    <ul class="factors">
        @foreach (var factor in Model.Account.Factors)
        {
            <li>@IndexModel.Name(factor): set up @IndexModel.Format(factor.EnrolledAtUtc), last used @IndexModel.Format(factor.LastUsedAtUtc)</li>
        }
    </ul>
    @if (Model.FewRecoveryCodesLeft)
    {
        <p class="warning" role="status">Only @Model.Account.RemainingRecoveryCodes recovery codes left. Get new ones so you can still sign in if you lose your authenticator app.</p>
    }
    else
    {
        <p>@Model.Account.RemainingRecoveryCodes recovery codes left.</p>
    }
    <p class="links">
        <a href="@Model.AccountUrl/authenticator/replace">Replace your authenticator app</a><br />
        <a href="@Model.AccountUrl/recovery-codes">Get new recovery codes</a>
        @if (!Model.Account.MfaRequired)
        {
            <br />
            <a href="@Model.AccountUrl/two-step/remove">Turn off two-step verification</a>
        }
    </p>
}
else if (Model.Account.MfaAvailable)
{
    <p>Off. Add a code from an authenticator app to your sign-in.</p>
    <p><a href="@Model.AccountUrl/authenticator">Set up an authenticator app</a></p>
}
else
{
    <p>Not available.</p>
}

<h2>Sign out</h2>
<form method="post" action="/tenants/@Model.Slug/endsession" asp-antiforgery="true">
    <button type="submit" name="confirm" value="true">Sign out</button>
</form>
