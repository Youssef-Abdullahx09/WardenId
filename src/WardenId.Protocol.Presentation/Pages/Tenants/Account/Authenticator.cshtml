@page "/tenants/{slug}/account/authenticator"
@model AuthenticatorModel
@{ ViewData["Title"] = "Set up an authenticator app"; }

@if (Model.RecoveryCodes is { } codes)
{
    <h1>Save your recovery codes</h1>
    <p>Your authenticator app is set up. If you lose it, you can sign in with one of these codes instead.
        Each code works once. Keep them somewhere safe: they won't be shown again.</p>
    <partial name="_RecoveryCodes" model="codes" />
    <a class="button" href="@Model.AccountUrl">Back to your account</a>
}
else
{
    <h1>Set up an authenticator app</h1>
    @if (Model.ErrorMessage is { } error)
    {
        <p class="error" role="alert">@error</p>
    }
    @if (Model.Enrollment is { } enrollment)
    {
        <partial name="_TotpEnrollment" model="enrollment" />
    }
    else
    {
        <p>After your password, you will also enter a code from an authenticator app on your phone when you sign in.</p>
        <form method="post" asp-page-handler="Start">
            <button type="submit">Start</button>
        </form>
    }
    <p class="links"><a href="@Model.AccountUrl">Back to your account</a></p>
}
