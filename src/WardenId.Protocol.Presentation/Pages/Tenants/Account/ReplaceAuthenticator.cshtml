@page "/tenants/{slug}/account/authenticator/replace"
@model ReplaceAuthenticatorModel
@{ ViewData["Title"] = "Replace your authenticator app"; }

@if (Model.RecoveryCodes is { } codes)
{
    <h1>Save your recovery codes</h1>
    <p>Your new authenticator app is set up and the old one no longer works. Your old recovery codes no longer
        work either: use these instead. Each code works once. Keep them somewhere safe: they won't be shown again.
        You have been signed out everywhere else.</p>
    <partial name="_RecoveryCodes" model="codes" />
    <a class="button" href="@Model.AccountUrl">Back to your account</a>
}
else
{
    <h1>Replace your authenticator app</h1>
    @if (Model.ErrorMessage is { } error)
    {
        <p class="error" role="alert">@error</p>
    }
    @if (Model.Enrollment is { } enrollment)
    {
        <partial name="_TotpEnrollment" model="enrollment" />
    }
    else
    {
        <p>First, enter a code from your current authenticator app, or one of your recovery codes.</p>
        <form method="post" asp-page-handler="Start">
            <label for="CurrentCode">Code</label>
            <input id="CurrentCode" name="CurrentCode" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" required autofocus />
            <button type="submit">Continue</button>
        </form>
    }
    <p class="links"><a href="@Model.AccountUrl">Back to your account</a></p>
}
