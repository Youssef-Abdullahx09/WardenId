@page "/tenants/{slug}/account/recovery-codes"
@model RecoveryCodesModel
@{ ViewData["Title"] = "New recovery codes"; }

@if (Model.RecoveryCodes is { } codes)
{
    <h1>Save your new recovery codes</h1>
    <p>Your old recovery codes no longer work. Each of these works once. Keep them somewhere safe: they won't be
        shown again.</p>
    <partial name="_RecoveryCodes" model="codes" />
    <a class="button" href="@Model.AccountUrl">Back to your account</a>
}
else
{
    <h1>New recovery codes</h1>
    @if (Model.ErrorMessage is { } error)
    {
        <p class="error" role="alert">@error</p>
    }
    <p>Enter the 6-digit code from your authenticator app. Your current recovery codes will stop working.</p>
    <form method="post">
        <label for="Code">Code</label>
        <input id="Code" name="Code" inputmode="numeric" pattern="[0-9 ]*" autocomplete="one-time-code" maxlength="8" required autofocus />
        <button type="submit">Get new recovery codes</button>
    </form>
    <p class="links"><a href="@Model.AccountUrl">Back to your account</a></p>
}
