@page "/tenants/{slug}/account/password"
@model PasswordModel
@{ ViewData["Title"] = "Change your password"; }

@if (Model.Changed)
{
    <h1>Password changed</h1>
    <p role="status">Your password has been changed and you have been signed out everywhere. Please sign in again.</p>
    <a class="button" href="@Model.SignInUrl">Sign in again</a>
}
else
{
    <h1>Change your password</h1>
    @if (Model.ErrorMessage is { } error)
    {
        <p class="error" role="alert">@error</p>
    }
    <form method="post">
        <input type="hidden" name="Username" value="@Model.Account.Username" autocomplete="username" />
        <label for="CurrentPassword">Current password</label>
        <input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
        <label for="NewPassword">New password</label>
        <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" required />
        <label for="ConfirmPassword">Confirm new password</label>
        <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required />
        <button type="submit">Change password</button>
    </form>
    <p class="links">Changing your password signs you out on every device.<br /><a href="@Model.AccountUrl">Back to your account</a></p>
}
