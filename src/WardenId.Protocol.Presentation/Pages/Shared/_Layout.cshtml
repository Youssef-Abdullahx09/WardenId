<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · WardenId</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #f6f7f9; color: #1d2330; margin: 0; }
        main { max-width: 22rem; margin: 10vh auto; padding: 2rem; background: #fff; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        label { display: block; margin: 1rem 0 .25rem; }
        input:not([type=hidden]) { width: 100%; box-sizing: border-box; padding: .5rem; }
        button { margin-top: 1rem; padding: .5rem 1rem; }
        .error { color: #b00020; }
    </style>
</head>
<body>
<main>@RenderBody()</main>
</body>
</html>
