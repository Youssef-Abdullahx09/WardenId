<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · WardenId</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #f6f7f9; color: #1d2330; margin: 0; }
        main { max-width: 22rem; margin: 10vh auto; padding: 2rem; background: #fff; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        label { display: block; margin: 1rem 0 .25rem; }
        input:not([type=hidden]) { width: 100%; box-sizing: border-box; padding: .5rem; }
        button { margin-top: 1rem; padding: .5rem 1rem; }
        .error { color: #b00020; }
        .links { margin-top: 1rem; }
        .qr { text-align: center; }
        .qr svg { max-width: 100%; height: auto; }
        .secret { word-break: break-all; font-size: 1.05rem; }
        .codes { columns: 2; padding-left: 1.25rem; font-size: 1.05rem; }
        a.button { display: inline-block; margin-top: 1rem; padding: .5rem 1rem; border: 1px solid #767676; border-radius: 2px; background: #efefef; color: inherit; text-decoration: none; }
    </style>
</head>
<body>
<main>@RenderBody()</main>
</body>
</html>
