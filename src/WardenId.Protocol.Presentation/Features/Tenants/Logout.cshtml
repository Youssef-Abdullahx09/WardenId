@page "/tenants/{slug}/logout"
@model LogoutModel
@{ ViewData["Title"] = "Sign out"; }

@if (Model.Cancelled)
{
    <h1 class="auth-title">Sign-out cancelled</h1>
    <p class="auth-lede" role="status">You are still signed in.</p>
}
else
{
    <h1 class="auth-title">Sign out</h1>
    <p class="auth-lede">Do you want to sign out? You will be signed out of every application that uses this sign-in on this device.</p>
    <form method="post" action="/tenants/@Model.Slug/endsession" asp-antiforgery="true">
        @foreach (var parameter in Model.ForwardedParameters)
        {
            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
        }
        <button class="button" type="submit" name="confirm" value="true">Sign out</button>
        <button class="button button-secondary" type="submit" name="cancel" value="true">Cancel</button>
    </form>
}
