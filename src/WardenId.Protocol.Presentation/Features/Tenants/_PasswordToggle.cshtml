@model string
@* Show/hide control for the password input whose id is the model. Revealed by password-toggle.js
   (the page adds it in its Scripts section); stays hidden, and the form still works, without JS. *@
<button class="password-toggle" type="button" data-password-toggle aria-controls="@Model"
        aria-label="Show password" aria-pressed="false" hidden>
    <svg class="password-toggle-show" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
        <circle cx="12" cy="12" r="3" />
    </svg>
    <svg class="password-toggle-hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9.9 5.2A9.6 9.6 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-2.9 3.9M6.6 6.6A17.4 17.4 0 0 0 2 12s3.6 7 10 7a9.4 9.4 0 0 0 5.4-1.6" />
        <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18" />
    </svg>
</button>
