@model ReturnToApplication
@using WardenId.Protocol.Presentation.Utilities
@using WardenId.Protocol.Application.Utilities
<form method="post" action="@ProtocolPaths.Tenant(Model.Slug, ProtocolPaths.Endpoints.Authorize)" asp-antiforgery="true">
    @foreach (var parameter in Model.Parameters)
    {
        <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
    }
    <input type="hidden" name="@TenantPages.FormFields.Cancel" value="@XmlConvert.ToString(true)" />
    <button class="button button-secondary" type="submit">@Model.Label</button>
</form>
