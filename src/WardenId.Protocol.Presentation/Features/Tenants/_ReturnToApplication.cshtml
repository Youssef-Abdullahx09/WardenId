@model ReturnToApplication
<form method="post" action="/tenants/@Model.Slug/authorize" asp-antiforgery="true">
    @foreach (var parameter in Model.Parameters)
    {
        <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
    }
    <input type="hidden" name="cancel" value="true" />
    <button class="button button-secondary" type="submit">@Model.Label</button>
</form>
