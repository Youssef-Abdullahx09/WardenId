@* The code field and submit button of _TotpEnrollment's confirm step. *@
<div class="field">
    <label class="field-label" for="Code">Enter the 6-digit code your app shows</label>
    <input class="input input-code" id="Code" name="Code" inputmode="numeric" pattern="[0-9 ]*" autocomplete="one-time-code" maxlength="8" placeholder="000000" required autofocus />
</div>
<button class="button" type="submit">Verify and turn on</button>
