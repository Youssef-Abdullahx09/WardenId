@page "/tenants/{slug}/login"
@model LoginModel
@{ ViewData["Title"] = "Sign in"; }

@if (Model.BlockedMessage is { } message)
{
    <partial name="_SignInBlocked" model="new SignInBlockedView(message, Model.ReturnToApplication)" />
}
else if (Model.SignedIn)
{
    <h1 class="auth-title">You are signed in</h1>
    <p class="auth-lede">You can close this window and return to the application.</p>
    <a class="button" href="@Model.AccountUrl">Manage your account</a>
}
else
{
    <h1 class="auth-title">Sign in</h1>
    @if (Model.AlreadySignedIn)
    {
        <p class="auth-lede">You are already signed in. <a href="@Model.AccountUrl">Manage your account</a></p>
    }
    <partial name="_Alert" model="Model.ErrorMessage" />
    <form method="post">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="field">
            <label class="field-label" for="EmailOrUsername">Email or username</label>
            <input class="input" id="EmailOrUsername" name="EmailOrUsername" value="@Model.EmailOrUsername" autocomplete="username" autocapitalize="off" spellcheck="false" required autofocus />
        </div>
        <div class="field">
            <label class="field-label" for="Password">Password</label>
            <div class="password-field">
                <input class="input" id="Password" name="Password" type="password" autocomplete="current-password" required />
                <partial name="_PasswordToggle" model='"Password"' />
            </div>
        </div>
        <button class="button" type="submit">Sign in</button>
    </form>
    @if (Model.ReturnToApplication is { } back)
    {
        <partial name="_ReturnToApplication" model="back" />
    }
}

@section Scripts {
    <script src="~/_content/WardenId.Protocol.Presentation/js/password-toggle.js" asp-append-version="true" defer></script>
}
