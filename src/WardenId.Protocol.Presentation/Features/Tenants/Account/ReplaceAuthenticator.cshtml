@page "/tenants/{slug}/account/authenticator/replace"
@model ReplaceAuthenticatorModel
@{ ViewData["Title"] = "Replace your authenticator app"; }

@if (Model.RecoveryCodes is { } codes)
{
    <h1 class="auth-title">Save your recovery codes</h1>
    <p class="auth-lede">Your new authenticator app is set up and the old one no longer works. Your old recovery codes no longer
        work either: use these instead. Each code works once. Keep them somewhere safe: they won't be shown again.
        You have been signed out everywhere else.</p>
    <partial name="_RecoveryCodes" model="codes" />
    <a class="button" href="@Model.AccountUrl">Back to your account</a>
}
else
{
    <h1 class="auth-title">Replace your authenticator app</h1>
    @if (Model.Enrollment is null)
    {
        <p class="auth-lede">First, enter a code from your current authenticator app, or one of your recovery codes.</p>
    }
    <partial name="_Alert" model="Model.ErrorMessage" />
    @if (Model.Enrollment is { } enrollment)
    {
        <partial name="_TotpEnrollment" model="enrollment" />
    }
    else
    {
        <form method="post" asp-page-handler="Start">
            <div class="field">
                <label class="field-label" for="CurrentCode">Verification code</label>
                @* No inputmode="numeric": recovery codes are accepted here too and aren't digits-only. *@
                <input class="input input-code" id="CurrentCode" name="CurrentCode" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" required autofocus />
            </div>
            <button class="button" type="submit">Continue</button>
        </form>
    }
    <ul class="auth-links">
        <li><a href="@Model.AccountUrl">Back to your account</a></li>
    </ul>
}
