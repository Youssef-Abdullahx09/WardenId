@page "/tenants/{slug}/account/password"
@model PasswordModel
@{ ViewData["Title"] = "Change your password"; }

@if (Model.Changed)
{
    <h1 class="auth-title">Password changed</h1>
    <p class="auth-lede" role="status">Your password has been changed and you have been signed out everywhere. Please sign in again.</p>
    <a class="button" href="@Model.SignInUrl">Sign in again</a>
}
else
{
    <h1 class="auth-title">Change your password</h1>
    <p class="auth-lede">Changing your password signs you out on every device.</p>
    <partial name="_Alert" model="Model.ErrorMessage" />
    <form method="post">
        <input type="hidden" name="Username" value="@Model.Account.Username" autocomplete="username" />
        <div class="field">
            <label class="field-label" for="CurrentPassword">Current password</label>
            <div class="password-field">
                <input class="input" id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
                <partial name="_PasswordToggle" model='"CurrentPassword"' />
            </div>
        </div>
        <div class="field">
            <label class="field-label" for="NewPassword">New password</label>
            <div class="password-field">
                <input class="input" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" required />
                <partial name="_PasswordToggle" model='"NewPassword"' />
            </div>
        </div>
        <div class="field">
            <label class="field-label" for="ConfirmPassword">Confirm new password</label>
            <div class="password-field">
                <input class="input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required />
                <partial name="_PasswordToggle" model='"ConfirmPassword"' />
            </div>
        </div>
        <button class="button" type="submit">Change password</button>
    </form>
    <ul class="auth-links">
        <li><a href="@Model.AccountUrl">Back to your account</a></li>
    </ul>
}

@section Scripts {
    <script src="~/_content/WardenId.Protocol.Presentation/js/password-toggle.js" asp-append-version="true" defer></script>
}
