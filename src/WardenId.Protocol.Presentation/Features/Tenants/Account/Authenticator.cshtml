@page "/tenants/{slug}/account/authenticator"
@model AuthenticatorModel
@{ ViewData["Title"] = "Set up an authenticator app"; }

@if (Model.RecoveryCodes is { } codes)
{
    <h1 class="auth-title">Save your recovery codes</h1>
    <p class="auth-lede">Your authenticator app is set up. If you lose it, you can sign in with one of these codes instead.
        Each code works once. Keep them somewhere safe: they won't be shown again.</p>
    <partial name="_RecoveryCodes" model="codes" />
    <a class="button" href="@Model.AccountUrl">Back to your account</a>
}
else
{
    <h1 class="auth-title">Set up an authenticator app</h1>
    @if (Model.Enrollment is null)
    {
        <p class="auth-lede">After your password, you will also enter a code from an authenticator app on your phone when you sign in.</p>
    }
    <partial name="_Alert" model="Model.ErrorMessage" />
    @if (Model.Enrollment is { } enrollment)
    {
        <partial name="_TotpEnrollment" model="enrollment" />
    }
    else
    {
        <form method="post" asp-page-handler="Start">
            <button class="button" type="submit">Start</button>
        </form>
    }
    <ul class="auth-links">
        <li><a href="@Model.AccountUrl">Back to your account</a></li>
    </ul>
}
